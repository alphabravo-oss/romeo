{
  "name": "@romeo/api-client",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./generated/query": "./src/generated/query/index.ts",
    "./generated/sdk": "./src/generated/sdk/index.ts",
    "./generated/sdk/zod": "./src/generated/sdk/zod.gen.ts",
    "./runtime/browser": "./src/runtime/browser.ts",
    "./runtime/generated-client": "./src/runtime/generated-client.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.generated.json --noEmit",
    "generate": "node ../../scripts/prepare-query-openapi.mjs && openapi-ts --file openapi-ts.config.ts && node ../../scripts/normalize-generated-typescript.mjs src/generated",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.generated.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.2",
    "zod": "4.4.3"
  }
}
