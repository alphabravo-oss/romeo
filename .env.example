ROMEO_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://romeo:romeo@localhost:5432/romeo
GA_CHECKLIST_PATH=
DATA_CONNECTOR_LIVE_EVIDENCE_PATH=
DATA_CONNECTOR_WORKER_ENABLED=false
DATA_CONNECTOR_NETWORK_POLICY_ENABLED=false
TOOL_DISPATCH_WORKER_ENABLED=false
TOOL_DISPATCH_NETWORK_POLICY_ENABLED=false
POSTGRES_QUERY_PLAN_EVIDENCE_PATH=
POSTGRES_SLOW_QUERY_TELEMETRY_EVIDENCE_PATH=
POSTGRES_LOCK_TELEMETRY_EVIDENCE_PATH=
POSTGRES_ARCHIVAL_PARTITIONING_DECISION_PATH=
VALKEY_URL=redis://localhost:6379
REALTIME_EVENT_DRIVER=memory
REALTIME_EVENT_KEY_PREFIX=romeo:chat-events:v1
REALTIME_EVENT_TIMEOUT_MS=2000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=romeo
S3_ACCESS_KEY_ID=romeo
S3_SECRET_ACCESS_KEY=romeo-local-secret
WEBHOOK_SIGNING_KEY=dev-webhook-signing-key-change-me
SESSION_SECRET=replace-with-32-random-bytes
LOCAL_AUTH_SECRET_ENCRYPTION_KEY=replace-with-32-random-bytes-local-auth
# Encrypts stored provider credentials. The built-in default is rejected on purpose -- a value under
# 32 characters, starting with "dev-", or containing "change-me" fails the guard, so storing a
# provider API key errors until this is replaced. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANAGED_SECRET_ENCRYPTION_KEY=replace-with-32-random-bytes-managed-secrets
# Set to the previous key during a rotation so already-stored secrets stay readable; empty otherwise.
MANAGED_SECRET_ENCRYPTION_KEY_PREVIOUS=
VECTOR_ISOLATION_MODE=shared_row_scope
# Operator-only, exact comma-separated IDs; unknown, duplicate, or spaced entries fail startup.
CAPABILITY_PLATFORM_DISABLED_IDS=realtime_voice,external_provider_use,secure_compute,image_editing,multi_model_compare,streamed_output_policy
SCIM_ENABLED=false
# Local demo only. Enabling this grants unauthenticated administrator access.
DEV_SEEDED_LOGIN=false
