{
  "name": "romeo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @romeo/app dev",
    "build": "pnpm -r --sort build",
    "check": "pnpm -r --sort check",
    "check:public-api-errors": "tsx scripts/check-public-api-errors.mjs",
    "check:database-evolution-policy": "node scripts/check-database-evolution-policy.mjs",
    "check:architecture": "node scripts/check-architecture-ratchet.mjs",
    "check:source-suppressions": "node scripts/check-app-source-suppressions.mjs --self-test && node scripts/check-app-source-suppressions.mjs",
    "check:dependencies": "dependency-cruiser apps/app/src packages/*/src --config .dependency-cruiser.cjs --output-type err",
    "check:dead-code": "knip --include files,dependencies,unlisted,unresolved --treat-config-hints-as-errors",
    "check:container-image-policy": "node scripts/container-image-policy.mjs",
    "check:helm-production-policy": "node scripts/helm-production-policy-smoke.mjs",
    "check:dns-pinning-parity": "node scripts/check-dns-pinning-parity.mjs",
    "test": "pnpm -r --sort test",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "test:postgres-conformance": "pnpm --filter @romeo/db test:postgres-conformance",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "test:coverage": "node scripts/run-coverage.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:browser": "node scripts/run-browser-quality.mjs",
    "migrate:postgres": "pnpm --filter @romeo/db db:migrate",
    "seed:postgres": "pnpm --filter @romeo/db db:seed",
    "validate:postgres": "node scripts/validate-postgres-schema.mjs",
    "check:openapi-route-coverage": "node scripts/check-openapi-route-coverage.mjs",
    "check:version-consistency": "node scripts/check-version-consistency.mjs",
    "check:sdk-drift": "node scripts/check-python-sdk-drift.mjs",
    "check:sdk-typescript-drift": "node scripts/check-typescript-sdk-drift.mjs",
    "contract:breaking": "pnpm openapi:export && node scripts/check-openapi-compatibility-policy.mjs",
    "contract:lint": "pnpm openapi:export && spectral lint --ruleset .spectral.yaml dist/generated/openapi.json",
    "check:bundle-budget": "node scripts/check-app-bundle-budget.mjs",
    "backup:postgres": "node scripts/postgres-backup.mjs",
    "restore:postgres": "node scripts/postgres-restore.mjs",
    "backup:object-store": "node scripts/object-store-backup.mjs",
    "restore:object-store": "node scripts/object-store-restore.mjs",
    "restore:coordinated": "node scripts/coordinated-restore.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "monitoring:export": "node scripts/operational-monitoring-exporter.mjs",
    "validate:operational-monitoring": "node scripts/validate-operational-monitoring.mjs",
    "support:bundle": "node scripts/generate-support-bundle.mjs",
    "smoke:ssr-render": "node scripts/ssr-render-smoke.mjs",
    "openapi:export": "pnpm --filter @romeo/cli exec tsx ../../scripts/export-openapi.ts --output ../../dist/generated/openapi.json",
    "openapi:diff:json": "oasdiff breaking docs/api/openapi-baseline.json dist/generated/openapi.json --format json",
    "openapi:export:sdk": "pnpm --filter @romeo/cli exec tsx ../../scripts/export-openapi.ts --include-openwebui --output ../../dist/generated/openapi.json",
    "sdk:python": "pnpm openapi:export:sdk && node scripts/generate-python-sdk.mjs --openapi-file dist/generated/openapi.json",
    "sdk:typescript": "pnpm openapi:export:sdk && pnpm --filter @romeo/api-client generate",
    "test:browser:chat": "node scripts/browser-chat-acceptance.mjs",
    "test:browser:admin": "node scripts/admin-console-audit.mjs",
    "test:browser:matrix": "node scripts/browser-engine-matrix.mjs",
    "test:browser:run-sse": "node scripts/run-sse-browser-acceptance.mjs",
    "test:browser:visual": "node scripts/browser-visual-baselines.mjs",
    "test:browser:visual:update": "ROMEO_UPDATE_VISUAL_BASELINES=true node scripts/browser-visual-baselines.mjs",
    "test:browser:transcript-virtualization": "node scripts/transcript-virtualization-browser-benchmark.mjs",
    "smoke:compose": "node scripts/compose-smoke.mjs",
    "smoke:compose:auth": "node scripts/compose-auth-smoke.mjs",
    "smoke:compose:external-postgres": "node scripts/compose-external-postgres-smoke.mjs",
    "smoke:compose:secret-rotation": "node scripts/compose-secret-rotation-smoke.mjs",
    "smoke:compose:workers": "node scripts/compose-workers-smoke.mjs",
    "smoke:compose:backup-restore": "node scripts/compose-backup-restore-smoke.mjs",
    "smoke:kubernetes:render": "node scripts/kubernetes-render-smoke.mjs"
  },
  "devDependencies": {
    "@oasdiff-js/oasdiff-js": "1.0.0",
    "@stoplight/spectral-cli": "6.16.1",
    "@vitest/coverage-v8": "4.1.9",
    "agent-browser": "0.31.1",
    "dependency-cruiser": "18.1.0",
    "knip": "6.29.0",
    "oxlint": "1.76.0",
    "pixelmatch": "7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "7.0.0",
    "prettier": "^3.7.4",
    "tsx": "4.22.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "11.7.0"
  },
  "license": "Apache-2.0"
}
