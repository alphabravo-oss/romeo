{
  "schema": "romeo.secret-bearing-egress-inventory.v1",
  "scope": "OAuth, federated-identity, connector, and inference-provider requests that carry a client secret, authorization code, refresh token, access token, API key, cookie, or signed client assertion",
  "defaultPolicy": {
    "dns": "resolve_all_reject_entire_mixed_or_special_set_and_pin",
    "redirects": "deny",
    "scheme": "https_only",
    "tls": "platform_ca_validation_with_original_host_sni",
    "timeouts": "bounded",
    "responses": "stream_bounded",
    "logging": "stable_codes_only_no_url_headers_or_body"
  },
  "surfaces": [
    {
      "id": "tool_oauth_client_credentials_api",
      "source": "packages/core/src/services/tool-oauth-client-credentials.ts",
      "credentials": ["client_id", "client_secret", "access_token"],
      "destinationPolicy": "exact configured token URL plus connector resource allowlist",
      "boundary": "SecretBearingEgressClient"
    },
    {
      "id": "tool_oauth_client_credentials_worker",
      "source": "packages/cli/src/tool-dispatch-auth.ts",
      "credentials": ["client_id", "client_secret", "access_token"],
      "destinationPolicy": "exact claim-bound token URL; private-network exceptions are forbidden",
      "boundary": "assertResolvedHostAllowed + fetchApprovedHost"
    },
    {
      "id": "delegated_github_oauth",
      "source": "packages/core/src/services/delegated-oauth-github-provider.ts",
      "credentials": [
        "client_secret",
        "authorization_code",
        "refresh_token",
        "access_token"
      ],
      "destinationPolicy": "exact https://github.com/login/oauth/access_token for tokens; exact https://api.github.com origin for account and revocation",
      "boundary": "SecretBearingEgressClient"
    },
    {
      "id": "github_browser_oauth",
      "source": "packages/core/src/services/oauth2-pkce-service.ts",
      "credentials": ["client_secret", "authorization_code", "access_token"],
      "destinationPolicy": "exact https://github.com/login/oauth/access_token for tokens",
      "boundary": "SecretBearingEgressClient"
    },
    {
      "id": "github_browser_identity",
      "source": "packages/core/src/services/github-oauth2-auth-provider.ts",
      "credentials": ["access_token"],
      "destinationPolicy": "exact https://api.github.com origin",
      "boundary": "SecretBearingEgressClient"
    },
    {
      "id": "github_data_connector",
      "source": "packages/core/src/services/github-data-connector-executor.ts",
      "credentials": ["access_token", "delegated_access_token"],
      "destinationPolicy": "exact https://api.github.com origin",
      "boundary": "SecretBearingEgressClient"
    },
    {
      "id": "oidc_discovery_jwks_and_token",
      "source": "packages/core/src/services/oidc-egress.ts",
      "credentials": [
        "client_secret",
        "authorization_code",
        "access_token",
        "cookie",
        "signed_client_assertion"
      ],
      "destinationPolicy": "issuer origin plus explicit OIDC endpoint origins; redirects allowed only for credential-free discovery/JWKS",
      "boundary": "OidcEgressClient"
    },
    {
      "id": "openai_compatible_inference",
      "source": "packages/core/src/services/compatibility-provider-egress.ts",
      "credentials": ["api_key", "access_token"],
      "destinationPolicy": "exact reviewed HTTPS origin of the resolved tenant provider; credential-free local providers remain explicit",
      "boundary": "SecretBearingEgressClient"
    },
    {
      "id": "native_provider_inference",
      "source": "packages/core/src/services/provider-secret-egress.ts",
      "credentials": ["api_key", "access_token"],
      "destinationPolicy": "origin-routed exact reviewed HTTPS provider origins; sensitive headers to any unreviewed origin fail closed",
      "boundary": "SecretBearingEgressClient"
    }
  ]
}
