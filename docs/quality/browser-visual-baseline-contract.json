{
  "schemaVersion": 1,
  "viewports": [
    { "name": "mobile", "width": 375, "height": 812 },
    { "name": "desktop", "width": 1280, "height": 900 },
    { "name": "wide", "width": 1920, "height": 1080 }
  ],
  "themes": ["light", "dark"],
  "routes": [
    { "name": "chat", "path": "/", "requiredSelector": "#main-content" },
    {
      "name": "login",
      "path": "/login",
      "requiredSelector": ".rm-login-shell"
    },
    {
      "name": "admin-providers",
      "path": "/admin?section=providers",
      "requiredSelector": "#console-content"
    },
    {
      "name": "admin-access",
      "path": "/admin?section=access",
      "requiredSelector": "#console-content"
    },
    {
      "name": "admin-audit",
      "path": "/admin?section=audit",
      "requiredSelector": "#console-content"
    },
    {
      "name": "admin-posture",
      "path": "/admin?section=posture",
      "requiredSelector": "#console-content"
    },
    {
      "name": "settings-security",
      "path": "/settings?section=security",
      "requiredSelector": "#console-content"
    },
    { "name": "ui-gallery", "path": "/ui", "requiredSelector": "main" }
  ],
  "maxHorizontalOverflowPx": 0,
  "reducedMotion": "reduce"
}
